{{- /*
list.html.tmpl — a bookmark list page. Data: render.ListData.

This file also defines the pieces shared with search.html.tmpl and
results.html.tmpl (all three files are parsed into one template set, so
these definitions are visible from the other two):

  "page-css"       — the <style> block (no data)
  "bookmark-item"  — one <li> for a render.Bookmark; used by both the list
                     page and results.html.tmpl so the two cannot drift

This is a deliberately minimal, self-contained example: system fonts, no
external assets, dark mode via prefers-color-scheme. See TEMPLATES.md for
the full template contract.
*/ -}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bookmarks{{if gt .Page 1}} — Page {{.Page}}{{end}}</title>
    <meta name="description" content="Public bookmarks.">
    <meta name="generator" content="raindrop-public-browser {{.Version}}">
    <link rel="canonical" href="{{.CanonicalURL}}">
    {{template "page-css"}}
</head>
<body>
<header class="site-header">
    <nav aria-label="Main">
{{- /*
        aria-current="true", not "page": this link points at /1, which is only
        the current page when you are on page 1. "true" marks the current
        section, leaving "page" to the pagination control below, which knows
        which page you are actually on.
    */}}
        <a class="site-title" href="/1" aria-current="true">Bookmarks</a>
        <a href="/search">Search</a>
    </nav>
</header>

<main>
{{- if .Empty}}
    <div class="empty-state">
        <p>No bookmarks yet.</p>
    </div>
{{- else}}
    <ul class="bm-list">
{{- range .Bookmarks}}
{{template "bookmark-item" .}}
{{- end}}
    </ul>

{{- if gt .TotalPages 1}}
    <nav class="pagination" aria-label="Pagination">
        <ul>
{{- if .PrevURL}}
            <li><a href="{{.PrevURL}}" rel="prev">Previous page</a></li>
{{- end}}
{{- range .Pages}}
            <li><a href="{{.URL}}"{{if .Current}} aria-current="page"{{end}}><span class="visually-hidden">Page </span>{{.Num}}</a></li>
{{- end}}
{{- if .NextURL}}
            <li><a href="{{.NextURL}}" rel="next">Next page</a></li>
{{- end}}
        </ul>
    </nav>
{{- end}}
{{- end}}
</main>

<footer class="site-footer">
    <p>Served by raindrop-public-browser {{.Version}}.</p>
</footer>
</body>
</html>


{{- define "bookmark-item"}}
        <li class="bm-item">
{{- /* The title is the link; the card is not a wrapping anchor. */}}
            <div class="bm-text">
                <h2 class="bm-title"><a href="{{.URL}}" rel="noopener noreferrer">{{if .Title}}{{.Title}}{{else}}{{.URL}}{{end}}</a></h2>
{{- if .Excerpt}}
                <p class="bm-excerpt">{{.Excerpt}}</p>
{{- end}}
                <p class="bm-meta">
{{- if .Domain}}<span class="bm-domain">{{.Domain}}</span> · {{end}}<span class="bm-date">{{.Date}}</span></p>
            </div>
{{- /* No cover: the image is omitted entirely, never a placeholder. */}}
{{- if .CoverPath}}
            <div class="bm-cover">
                <img src="{{.CoverPath}}" alt="" loading="lazy" decoding="async">
            </div>
{{- end}}
        </li>
{{- end}}


{{- define "page-css"}}
    <style>
    :root {
      --bg: #ffffff;
      --fg: #1a1a1a;
      --muted: #555555;
      --border: #dddddd;
      --accent: #205080;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #111111;
        --fg: #eeeeee;
        --muted: #b0b0b0;
        --border: #3a3a3a;
        --accent: #8ab4e8;
      }
    }

    * { box-sizing: border-box; }

    body {
      max-width: 44rem;
      margin: 0 auto;
      padding: 1rem;
      font-family: system-ui, sans-serif;
      line-height: 1.5;
      color: var(--fg);
      background: var(--bg);
    }

    a { color: var(--accent); }

    /* Never remove the focus indicator (WCAG 2.4.7). */
    a:focus-visible, input:focus-visible, button:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 2px;
    }

    .visually-hidden {
      position: absolute !important;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .site-header nav {
      display: flex;
      gap: 1.5rem;
      align-items: baseline;
      padding-bottom: 0.75rem;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }

    .site-title {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--fg);
      text-decoration: none;
    }

    .empty-state {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 50vh;
      font-size: 1.3rem;
      color: var(--muted);
    }

    .bm-list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .bm-item {
      display: flex;
      gap: 1rem;
      justify-content: space-between;
      padding: 1rem 0;
      border-bottom: 1px solid var(--border);
    }

    .bm-text { min-width: 0; }

    .bm-title {
      margin: 0;
      font-size: 1.1rem;
      overflow-wrap: break-word;
    }

    .bm-excerpt {
      margin: 0.4rem 0 0;
      color: var(--muted);
      overflow-wrap: break-word;
    }

    .bm-meta {
      margin: 0.4rem 0 0;
      font-size: 0.85rem;
      color: var(--muted);
    }

    /*
      Covers come from arbitrary hosts, so their dimensions are unknown at
      render time; a fixed aspect-ratio box keeps lazy loads from shifting
      the layout under the pointer or keyboard focus.
    */
    .bm-cover {
      flex: 0 0 8rem;
      align-self: center;
    }

    .bm-cover img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: 4px;
      background: var(--border);
    }

    .pagination ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 1.5rem 0 0;
      padding: 0;
      list-style: none;
    }

    .pagination a {
      display: inline-flex;
      min-width: 2.75rem;
      min-height: 2.75rem;
      padding: 0.25rem 0.75rem;
      justify-content: center;
      align-items: center;
      border: 1px solid var(--border);
      border-radius: 4px;
      text-decoration: none;
    }

    .pagination a[aria-current="page"] {
      font-weight: 700;
      color: var(--bg);
      background: var(--accent);
      border-color: var(--accent);
    }

    .site-footer {
      margin-top: 2rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border);
      font-size: 0.85rem;
      color: var(--muted);
    }

    .search-form label {
      display: block;
      margin-bottom: 0.4rem;
      font-weight: 600;
    }

    .search-row {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .search-row input {
      flex: 1;
      min-width: 0;
      padding: 0.5rem 0.75rem;
      font: inherit;
      color: var(--fg);
      background: var(--bg);
      border: 1px solid var(--muted);
      border-radius: 4px;
    }

    .search-row button {
      padding: 0.5rem 1rem;
      font: inherit;
      color: var(--bg);
      background: var(--accent);
      border: 1px solid var(--accent);
      border-radius: 4px;
      cursor: pointer;
    }

    #search-results[aria-busy="true"] { opacity: 0.6; }

    .search-prompt { color: var(--muted); }

    @media (max-width: 480px) {
      .bm-item { flex-direction: column; }
      .bm-cover { flex-basis: auto; }
    }
    </style>
{{- end}}
