{{- /*
results.html.tmpl — the search-results region. Data: render.ResultsData.

This is a FRAGMENT: no <html>, <head>, or <body>. It is rendered two ways
and must be identical in both:

  1. included by search.html.tmpl inside <div id="search-results">
  2. returned on its own by the snippet endpoint /search/results?q=…, which
     the page's JavaScript drops into that same div

Every state ends with a hidden [data-search-status] element carrying
.StatusText; the script copies its text into the page's persistent
role="status" region. "bookmark-item" is defined in list.html.tmpl.

Order matters: .TooShort is checked before .Queried, because a too-short
query has .Queried false but is not the initial prompt state.
*/ -}}
{{- if .TooShort}}
{{- /*
        The user typed something, it was just too short to search on. Telling
        them to start typing would be wrong, so this is its own state.
    */}}
        <div class="search-tooshort">
            <p class="search-prompt">Enter at least 2 characters to search.</p>
            <div hidden data-search-status>{{.StatusText}}</div>
        </div>
{{- else if not .Queried}}
        <div class="search-empty" data-search-empty>
            <p class="search-prompt">Start typing to search…</p>
            <div hidden data-search-status>{{.StatusText}}</div>
        </div>
{{- else if not .Bookmarks}}
        <div class="search-noresults">
            <p class="search-prompt">No results for “{{.Query}}”.</p>
            <div hidden data-search-status>{{.StatusText}}</div>
        </div>
{{- else}}
        <div class="search-hits">
            <p class="search-count">
{{- if .Truncated}}More than {{.Count}} results{{else if eq .Count 1}}1 result{{else}}{{.Count}} results{{end}} for “{{.Query}}”</p>
            <ul class="bm-list">
{{- range .Bookmarks}}
{{template "bookmark-item" .}}
{{- end}}
            </ul>
{{- if .Truncated}}
            <p class="search-truncated">More than 100 matches — refine your search.</p>
{{- end}}
            <div hidden data-search-status>{{.StatusText}}</div>
        </div>
{{- end}}
